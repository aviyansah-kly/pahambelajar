{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pahambelajar",
  "compatibility_date": "2026-08-25",
  "main": "worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
